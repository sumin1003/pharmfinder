PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq AI (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# 식약처 공공데이터 API
MFDS_API_KEY=your_mfds_api_key
MFDS_API_URL=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService/getDrbEasyDrugList

# 카카오맵 REST API (지오코딩용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# 건강보험심사평가원 약국정보서비스 API (공공데이터포털)
HIRA_API_KEY=your_hira_api_key

# 서버 URL
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# 세션 시크릿 (OAuth 핸드셰이크용)
SESSION_SECRET=your_session_secret_here

# 카카오 OAuth (https://developers.kakao.com → 앱 키 → REST API 키)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret  # 카카오 로그인 → 보안 탭 (사용 설정 시 필수)

# 구글 OAuth (https://console.cloud.google.com → API 및 서비스 → OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 네이버 OAuth (https://developers.naver.com/apps)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
